#!/bin/sh
# Machine-specific paths for drift-ai. Load before running commands:
#
#   source ./env-drift-tools
#
# Game commands (tests, collection, training, benchmark) also need an X
# display: DISPLAY and XAUTHORITY must be set in your shell.

export VENV_PATH=~/Projects/venv
export BNG_HOME=~/Projects/BeamNG.tech.v0.39.4.0

# cupy is useful when you have more than one GPU, helps process the observation
# space faster
export USE_CUPY=false
